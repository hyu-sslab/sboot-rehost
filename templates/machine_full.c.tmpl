/*
 * QEMU machine: rehost-{{MODEL_LOWER}}   (unified chain)
 *
 * Generated by sboot-rehost. Honest model - see 06_machine/bypasses.md.
 *
 * ONE container, placed stage by stage. Everything after the first stage is
 * reached by the firmware's own code: this machine never loads a kernel, a DTB
 * or a ramdisk. If it did, the run would be indistinguishable from booting a
 * kernel directly, which is the one thing this flow exists not to do.
 *
 * Derived premises (from STATIC.md / stage_map.json - never borrowed):
 *   stages           {{STAGE_SUMMARY}}
 *   reset PC         {{RESET_PC}}
 *   has_el3          {{HAS_EL3}}   (from which vbar_el* the entry stub writes)
 *   handoff window   {{HANDOFF_BASE}}  ({{HANDOFF_SLOT_COUNT}} slots)
 *   boot medium      {{HCI_KIND}} @ {{HCI_BASE}}
 */

#include "qemu/osdep.h"
#include "qapi/error.h"
#include "qemu/error-report.h"
#include "qemu/log.h"
#include "qemu/units.h"
#include "qom/object.h"
#include "hw/sysbus.h"
#include "hw/boards.h"
#include "hw/qdev-core.h"
#include "hw/loader.h"
#include "hw/arm/boot.h"
#include "system/reset.h"
#include "system/system.h"
#include "system/block-backend.h"
#include "target/arm/cpu.h"
#include "cpu.h"
#include "chardev/char-fe.h"
#include "hw/arm/machines-qom.h"

#define TYPE_REHOST_MACHINE MACHINE_TYPE_NAME("rehost-{{MODEL_LOWER}}")
OBJECT_DECLARE_SIMPLE_TYPE(RehostState, REHOST_MACHINE)

/* ---- Memory skeleton (derived) ---- */
#define DRAM_BASE     {{DRAM_BASE}}ULL
#define DRAM_SIZE     ({{DRAM_SIZE_MB}}ULL * MiB)
#define SRAM0_BASE    {{SRAM0_BASE}}ULL      /* where the first stage runs */
#define SRAM0_SIZE    ({{SRAM0_SIZE_KB}}ULL * KiB)
#define IRAM_BASE     {{IRAM_BASE}}ULL       /* handoff window + stage data */
#define IRAM_SIZE     ({{IRAM_SIZE_KB}}ULL * KiB)

#define RESET_PC      {{RESET_PC}}ULL
#define HANDOFF_BASE  {{HANDOFF_BASE}}ULL

#define PERI_LO_BASE  {{PERI_LO_BASE}}ULL
#define PERI_LO_SIZE  ({{PERI_LO_SIZE_MB}}ULL * MiB)
#define UART_BASE_OFF {{UART_BASE_OFF}}ULL   /* offset within peri_lo */
#define UART_TX_OFF   (UART_BASE_OFF + {{UART_TX_DELTA}})
#define UART_RX_OFF   (UART_BASE_OFF + {{UART_RX_DELTA}})
#define UART_STAT_OFF (UART_BASE_OFF + {{UART_STAT_DELTA}})

/* ---- State ---- */
struct RehostState {
    MachineState parent_obj;
    ARMCPU *cpu;
    MemoryRegion sram0, iram, heap_ram;
    MemoryRegion peri_lo, peri_mid, peri_hi;
    CharFrontend uart_chr;
    uint8_t  rx[256];
    unsigned rx_head, rx_tail, rx_count;
    uint64_t rx_served, rx_empty, rx_polls;
    BlockBackend *medium;                /* the synthesised boot medium */
};

static RehostState *g_state;

/* =========================================================================
 * UART - the honesty-critical part. Do not restructure.
 * ========================================================================= */

static int uart_can_receive(void *opaque) {
    RehostState *s = opaque;
    return sizeof(s->rx) - s->rx_count;
}
static void uart_receive(void *opaque, const uint8_t *buf, int sz) {
    RehostState *s = opaque;
    for (int i = 0; i < sz && s->rx_count < sizeof(s->rx); i++) {
        s->rx[s->rx_head] = buf[i];
        s->rx_head = (s->rx_head + 1) % sizeof(s->rx);
        s->rx_count++;
    }
}
/* There is deliberately no function that fills rx[] from inside the machine.
 * Input arrives only through uart_receive above, i.e. from the harness outside
 * QEMU. A machine that seeds its own console types its own commands, and a
 * surface reached that way is verifying itself (honesty rule 7). verify.py
 * fails the run when it finds one. */

/* Reported on stderr, never on the console: run_full.sh keeps stderr in its own
 * file, so nothing here can reach console_<n>.txt and taint the byte-match or
 * source-negative checks. Field names are single letters because verify.py asks
 * whether a console token appears in any machine string literal by substring -
 * nothing shorter than five characters can collide.
 *   s = bytes handed to the firmware   e = reads that found the buffer empty
 *   p = status-register polls          q = bytes still queued */
static void rehost_rx_report(RehostState *s) {
    info_report("REHOST-RX s=%" PRIu64 " e=%" PRIu64 " p=%" PRIu64 " q=%u",
                s->rx_served, s->rx_empty, s->rx_polls, s->rx_count);
}

static uint64_t peri_lo_read(void *opaque, hwaddr off, unsigned sz) {
    RehostState *s = opaque;
    if (off == UART_STAT_OFF) {
        uint64_t st = {{UART_STAT_IDLE}};
        if (s->rx_count > 0) st |= {{UART_STAT_RXREADY}};
        s->rx_polls++;
        if (s->rx_polls == 1 || (s->rx_polls & 0xfffffULL) == 0) rehost_rx_report(s);
        return st;
    }
    if (off == UART_RX_OFF) {
        if (s->rx_count > 0) {
            uint8_t b = s->rx[s->rx_tail];
            s->rx_tail = (s->rx_tail + 1) % sizeof(s->rx);
            s->rx_count--;
            s->rx_served++;
            /* Required: once can_receive returned 0, QEMU stops feeding this
             * chardev until told the backlog cleared. Omitting it makes input
             * stop arriving partway through - fatal for a gate that needs a run
             * of keystrokes. */
            qemu_chr_fe_accept_input(&s->uart_chr);
            if (s->rx_count == 0) rehost_rx_report(s);
            return b;
        }
        s->rx_empty++;
        if (s->rx_empty == 1 || (s->rx_empty & 0xffffULL) == 0) rehost_rx_report(s);
        return 0;
    }
    /* {{PERI_READ_BLOCK}}
     * One case per window the firmware actually polls, each returning ONLY the
     * bit it waits for. Never 0xFFFFFFFF as a catch-all: extra bits set send the
     * firmware down a branch it would not take on the device, and that is a
     * wrong model that happens to proceed (honesty rule 1). */
    return 0;
}

static void peri_lo_write(void *opaque, hwaddr off, uint64_t val, unsigned sz) {
    RehostState *s = opaque;
    if (off == UART_TX_OFF) {
        /* THE ONLY console write in this file. verify.py counts the call sites;
         * a second one means the machine can print, and then nothing on the
         * console proves the firmware printed it. */
        uint8_t b = val & 0xff;
        qemu_chr_fe_write_all(&s->uart_chr, &b, 1);
        return;
    }
    /* {{PERI_WRITE_BLOCK}} - absorb, or record what a later read must answer. */
}

static const MemoryRegionOps peri_lo_ops = {
    .read = peri_lo_read, .write = peri_lo_write,
    .endianness = DEVICE_LITTLE_ENDIAN,
    .valid = { .min_access_size = 1, .max_access_size = 8 },
    .impl  = { .min_access_size = 1, .max_access_size = 4 },
};

/* =========================================================================
 * Stage placement
 * ========================================================================= */

typedef struct { const char *name; uint64_t file_off, size, load_va; } StagePlace;

/* Exactly the executable stages from stage_map.json, in chain order. A stage the
 * map marked `encrypted` is NOT listed here: it cannot run, and loading it would
 * only put bytes where the firmware might jump. */
static const StagePlace stages[] = {
    /* {{STAGE_TABLE_BLOCK}}
     * { "bl1", 0x0, 0x5000, 0x00000000ULL },  ... */
};

/* Map a guest VA to the host pointer of whichever RAM region backs it. Writing
 * through the region pointer is required: cpu_physical_memory_write leaves the
 * TCG translation cache stale, so a patch appears to apply and the guest keeps
 * executing the old bytes - a whole round wasted on a change that did land. */
static uint8_t *host_for(RehostState *s, MachineState *ms, uint64_t va, uint64_t len) {
    struct { MemoryRegion *mr; uint64_t base, size; } regions[] = {
        { ms->ram,   DRAM_BASE,  DRAM_SIZE  },
        { &s->sram0, SRAM0_BASE, SRAM0_SIZE },
        { &s->iram,  IRAM_BASE,  IRAM_SIZE  },
    };
    for (size_t i = 0; i < ARRAY_SIZE(regions); i++) {
        if (va >= regions[i].base && va + len <= regions[i].base + regions[i].size) {
            return memory_region_get_ram_ptr(regions[i].mr) + (va - regions[i].base);
        }
    }
    return NULL;
}

static void place_stages(RehostState *s, MachineState *ms) {
    if (!ms->kernel_filename) {
        error_report("no container given (-kernel <container.bin>)"); exit(1);
    }
    FILE *f = fopen(ms->kernel_filename, "rb");
    if (!f) { error_report("cannot open '%s'", ms->kernel_filename); exit(1); }
    fseek(f, 0, SEEK_END); long total = ftell(f); fseek(f, 0, SEEK_SET);
    if (total <= 0) { error_report("empty container"); exit(1); }
    uint8_t *buf = g_malloc0(total);
    if (fread(buf, 1, total, f) != (size_t)total) { error_report("short read"); exit(1); }
    fclose(f);

    for (size_t i = 0; i < ARRAY_SIZE(stages); i++) {
        const StagePlace *st = &stages[i];
        if (st->file_off + st->size > (uint64_t)total) {
            error_report("stage %s runs past the container", st->name); exit(1);
        }
        uint8_t *dst = host_for(s, ms, st->load_va, st->size);
        if (!dst) {
            error_report("stage %s: no RAM region covers 0x%" PRIx64,
                         st->name, st->load_va);
            exit(1);
        }
        memcpy(dst, buf + st->file_off, st->size);
        info_report("rehost: stage %zu/%zu placed at 0x%" PRIx64 " (%" PRIu64 " bytes)",
                    i + 1, ARRAY_SIZE(stages), st->load_va, st->size);
    }
    g_free(buf);

    /* {{HANDOFF_STUBS_BLOCK}}
     * The first stage has no predecessor here, so whatever the boot ROM left it
     * must be supplied. For each slot the firmware CALLS, emit a tiny routine
     * into scratch RAM and store its address in the slot:
     *     mov w0, #<value the caller checks>   (0x52800000 | (v << 5))
     *     ret                                  (0xD65F03C0)
     * Derive the value from the call site's own test, never from what the slot's
     * position suggests. Every slot filled here is a bypass and needs its four
     * fields in bypasses.md - this is modelling the boot ROM's OUTPUT, and the
     * boot ROM itself is not being executed.
     *
     * Data slots (a work-buffer pointer, sizes) are plain writes, not stubs. */

    /* {{SKIP_REDIRECT_BLOCK}}
     * For each encrypted stage: patch the previous stage's call/branch to it so
     * it goes to the next EXECUTABLE stage's entry instead. Four-field bypass,
     * and only after reading the original 4 bytes and confirming the pre-image.
     * Never synthesise a value the skipped stage would have written - if a later
     * stage reads one, that is a finding, not something to fill in. */
}

/* =========================================================================
 * EL3 / SMC
 * ========================================================================= */

/* {{SMC_HANDLER_BLOCK}}
 * One case per function id the firmware actually issues. PSCI goes to
 * arm_handle_psci_call; SiP/vendor ids answer what the caller checks. An
 * unhandled id must fall through to SMCCC NOT_SUPPORTED rather than to a
 * success the firmware then trusts. */

/* ---- CPU reset ---- */
static void cpu_reset_hook(void *opaque) {
    ARMCPU *cpu = opaque;
    CPUState *cs = CPU(cpu);
    cpu_reset(cs);
    /* The first stage's own entry, from stage_map.json. NOT the load address:
     * file offset 0 is the container header, and entering there executes header
     * bytes as instructions. */
    cpu_set_pc(cs, (vaddr)RESET_PC);
    CPUARMState *env = &cpu->env;
    env->cp15.sctlr_el[1] = 0;
    env->cp15.sctlr_el[2] = 0;
    env->cp15.cpacr_el1 = 0x300000ULL;
    /* {{RESET_STATE_BLOCK}} - only registers the first stage READS before it
     * writes them. Anything else here is invention. */
}

/* ---- Machine init ---- */
static void rehost_init(MachineState *ms) {
    RehostState *s = REHOST_MACHINE(ms);
    MemoryRegion *sysmem = get_system_memory();
    g_state = s;

    Object *cpuobj = object_new(ms->cpu_type);
    /* has_el3 follows the stage's own entry stub: whichever vbar_el* it writes
     * is the level it expects. Defaulting either way breaks it silently. */
    object_property_set_bool(cpuobj, "has_el3", {{HAS_EL3}}, &error_fatal);
    object_property_set_bool(cpuobj, "has_el2", {{HAS_EL2}}, &error_fatal);
    qdev_realize(DEVICE(cpuobj), NULL, &error_fatal);
    s->cpu = ARM_CPU(cpuobj);

    memory_region_add_subregion(sysmem, DRAM_BASE, ms->ram);

    memory_region_init_ram(&s->sram0, NULL, "rehost.sram0", SRAM0_SIZE, &error_fatal);
    memory_region_add_subregion(sysmem, SRAM0_BASE, &s->sram0);
    memory_region_init_ram(&s->iram, NULL, "rehost.iram", IRAM_SIZE, &error_fatal);
    memory_region_add_subregion(sysmem, IRAM_BASE, &s->iram);

    memory_region_init_io(&s->peri_lo, NULL, &peri_lo_ops, s,
                          "rehost.peri_lo", PERI_LO_SIZE);
    memory_region_add_subregion(sysmem, PERI_LO_BASE, &s->peri_lo);
    /* {{PERI_REGIONS_BLOCK}} - one region per window the firmware touches. Add
     * them as rounds observe them; a blanket map hides which are real. */

    if (serial_hd(0)) {
        qemu_chr_fe_init(&s->uart_chr, serial_hd(0), &error_abort);
        qemu_chr_fe_set_handlers(&s->uart_chr, uart_can_receive,
                                 uart_receive, NULL, NULL, s, NULL, true);
    }

    /* {{STORAGE_BLOCK}}
     * The boot medium, from templates/storage_hci.c.tmpl. The bootloader reads
     * the next stage through it and the kernel later reads rootfs through the
     * SAME model - a model fitted to one driver and broken under the other is a
     * model of that driver's expectations, not of the controller.
     *   s->medium = blk_by_name("lu0");   (run_full.sh attaches it as -drive) */

    place_stages(s, ms);
    qemu_register_reset(cpu_reset_hook, s->cpu);
}

static const char * const rehost_valid_cpu_types[] = {
    ARM_CPU_TYPE_NAME("{{CPU_TYPE}}"), NULL,
};

static void rehost_class_init(ObjectClass *oc, const void *data) {
    MachineClass *mc = MACHINE_CLASS(oc);
    mc->desc = "{{MODEL}} unified chain (auto-generated by sboot-rehost)";
    mc->init = rehost_init;
    mc->max_cpus = {{SMP}};
    mc->min_cpus = 1;
    mc->default_cpus = {{SMP}};
    mc->default_cpu_type = ARM_CPU_TYPE_NAME("{{CPU_TYPE}}");
    mc->valid_cpu_types = rehost_valid_cpu_types;
    mc->default_ram_size = DRAM_SIZE;
    mc->default_ram_id = "rehost.dram";
}

static const TypeInfo rehost_info = {
    .name = TYPE_REHOST_MACHINE,
    .parent = TYPE_MACHINE,
    .instance_size = sizeof(RehostState),
    .class_init = rehost_class_init,
    /* REQUIRED on QEMU 10.2.2: without it the type registers but `-M help` and
     * `-M <name>` never find it. Declared in hw/arm/machines-qom.h (included
     * above), defined in target/arm/machine.c. */
    .interfaces = arm_aarch64_machine_interfaces,
};

static void rehost_register(void) { type_register_static(&rehost_info); }
type_init(rehost_register)
