#define KERNEL_VA_BASE   {{KERNEL_VA_BASE}}ULL
#define KERNEL_PA_BASE   {{KERNEL_PA_BASE}}ULL
#define KERNEL_VA_TO_PA(va) ((va) - KERNEL_VA_BASE + KERNEL_PA_BASE)

