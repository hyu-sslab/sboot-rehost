/* ---- Structural constants (not chip values) ---- */
#define NUM_CPUS         2     /* the machine creates its two CPUs itself; -smp is not honoured */
#define CPU_MONITOR      0     /* QEMU numbers GIC CPU interfaces by creation order: the CPU that */
#define CPU_BOOT         1     /*   runs the EL3 monitor is created first (see rehost_create_cpus) */
#define MMIO_PAGE_SHIFT  12    /* first-access logging granularity: one line per 4 KiB page */
#define POLL_THRESHOLD   3000  /* same address read this many times in a row = a polling loop */
#define POLL_REPORT_MAX  64    /* distinct polled addresses reported once each */
#define HANDOFF_POLL_MS  5     /* virtual-time poll of the warm-reset request */
#define PATCH_POLL_MS    2     /* virtual-time poll for runtime patch targets */
#define PATCH_MAX_LEN    8     /* bytes per patch row */
#define PATCH_ID_MAX     256   /* longest build identifier compared (bytes) */
#define MAX_DEDICATED    64
#define VECTOR_SLOTS     8     /* AArch32 exception vector slots */

/* Architectural encoding of the A32 instruction "b ." (branch to self). Not a chip value:
 * an exception taken while the stage has no vectors parks observably instead of
 * cascading into unmapped-memory faults. */
#define ARM_A32_B_SELF   0xEAFFFFFEU

/* ---- Memory skeleton (derived: STATIC.md "memory" and the stage map) ---- */
#define DRAM_BASE        {{DRAM_BASE}}ULL
#define DRAM_SIZE        ({{DRAM_SIZE_MB}}ULL * MiB)
/* The first stage runs from on-chip RAM before DRAM exists. Its true size is a derived
 * fact or "undetermined"; an oversized region hides a stray access, so narrow it once
 * observed bounds exist. */
#define SRAM_BASE        {{SRAM_BASE}}ULL
#define SRAM_SIZE        ({{SRAM_SIZE_KB}}ULL * KiB)
/* Low vector page the boot ROM would leave behind. Its existence and contents are NOT
 * derived (source: assumed) - record that in the entry's "reason". Drop this region if
 * the first stage installs its own vectors before any exception can occur. */
#define VECTOR_PAGE_BASE {{VECTOR_PAGE_BASE}}ULL
#define VECTOR_PAGE_SIZE ({{VECTOR_PAGE_SIZE_KB}}ULL * KiB)

/* Host-visible kernel-log region (memdump channel, memdump_plan.json): the host reads
