/* ---- Phases ---- */
enum { PH_PRE = 1, PH_POST = 2, PH_BOTH = 3 };
static bool g_post_handoff;   /* set when the warm reset into AArch64 has been performed */
static bool phase_active(unsigned ph) { return ph & (g_post_handoff ? PH_POST : PH_PRE); }

/* ---- State ---- */
struct RehostMixedState {
    MachineState parent_obj;
    ARMCPU *cpu[NUM_CPUS];
    DeviceState *gic;
    MemoryRegion sram, vectors, uart_io;
    CharFrontend uart_chr;
    uint8_t  rx[256];
    unsigned rx_head, rx_tail, rx_count;
    uint64_t rx_served, rx_empty, rx_polls;   /* reported on stderr (rehost_rx_report) */
    BlockBackend *medium;              /* the synthesised boot medium (connection point below) */
    QEMUTimer *handoff_timer, *patch_timer, *heartbeat_timer;
};

static RehostMixedState *g_state;
static uint64_t g_time_scale = 1;
static bool g_patches_enabled = true;

#define HOST_LOG(fmt, ...) info_report("rehost: " fmt, ##__VA_ARGS__)

/* =========================================================================
 * Diagnostic environment variables (read once; none changes what the firmware
 * is told unless noted - those that do must be recorded when used).
 *   REHOST_MEMDUMP_REGION=<base>:<size>
 *                            not a diagnostic: the host-read memdump region the machine
 *                            must never write (see memdump_guard_init)
 *   REHOST_HEARTBEAT=1       host line each virtual second (virtual vs real time)
 *   REHOST_TIME_SCALE=<n>    free-running counters of dedicated timer models run n
 *                            times faster (changes what the firmware measures)
 *   REHOST_RUNTIME_PATCHES=0 do not apply runtime patch rows (isolates a stall that a
 *                            patch caused; rows are still reported as not applied)
 * ========================================================================= */
static void rehost_env_init(void) {
    const char *v = getenv("REHOST_TIME_SCALE");
    if (v && *v) {
        g_time_scale = strtoull(v, NULL, 0);
        if (!g_time_scale) g_time_scale = 1;
    }
    v = getenv("REHOST_RUNTIME_PATCHES");
    if (v && (!strcmp(v, "0") || !strcmp(v, "off"))) g_patches_enabled = false;
}

/* Virtual-clock free-running counter for dedicated timer models. */
static G_GNUC_UNUSED uint64_t rehost_virtual_ticks(uint32_t freq_hz) {
    return muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), freq_hz,
                    NANOSECONDS_PER_SECOND) * g_time_scale;
}

/* =========================================================================
 * Guest memory access - the single write path once guest code can run
 * ========================================================================= */

/* begin: guest memory access */
/* The host-read region, from REHOST_MEMDUMP_REGION. Size 0 = no guard. */
static uint64_t g_memdump_base, g_memdump_size;

/* "<base>:<size>", each a C integer (0x.. hex or decimal). Anything else is refused: a
 * guard that half-parsed would guard a different range than the one the host reads. */
static bool memdump_region_parse(const char *spec, uint64_t *base, uint64_t *size) {
    char *end;
    if (!spec || *spec < '0' || *spec > '9') return false;
    errno = 0;
    uint64_t b = strtoull(spec, &end, 0);
    if (errno || *end != ':' || end[1] < '0' || end[1] > '9') return false;
    const char *p = end + 1;
    uint64_t n = strtoull(p, &end, 0);
    if (errno || *end != '\0' || n == 0 || b + n < b) return false;
    *base = b;
    *size = n;
    return true;
}

/* Without the variable there is no guard (logged: a silent "off" would read as "on"). A
 * malformed value stops the machine, like a malformed patch row: the guard is a safety
 * property, and a wrong range is worse than none. */
static void memdump_guard_init(void) {
    const char *v = getenv("REHOST_MEMDUMP_REGION");
    if (!v || !*v) {
        HOST_LOG("memdump guard: off (REHOST_MEMDUMP_REGION not set; with the memdump "
                 "channel on, the run script must export it)");
        return;
    }
    if (!memdump_region_parse(v, &g_memdump_base, &g_memdump_size)) {
        error_report("rehost: REHOST_MEMDUMP_REGION must be <base>:<size> (C integers, "
                     "size > 0), got '%s'", v);
        exit(1);
    }
    HOST_LOG("memdump guard: host-read region 0x%" PRIx64 " size 0x%" PRIx64
             " is never written", g_memdump_base, g_memdump_size);
}

static bool rehost_guest_read(uint64_t addr, void *buf, size_t len) {
    return address_space_read(&address_space_memory, addr, MEMTXATTRS_UNSPECIFIED,
                              buf, len) == MEMTX_OK;
}

static bool in_memdump(uint64_t addr, uint64_t len) {
    return g_memdump_size && addr < g_memdump_base + g_memdump_size && g_memdump_base < addr + len;
}

/* address_space_write (not a raw RAM pointer) so translated blocks over the written
 * bytes are invalidated: a runtime patch that lands on code already executed must be
 * seen. Container-time writes before the first instruction use the region pointer. */
static bool rehost_guest_write(uint64_t addr, const void *buf, size_t len) {
    if (in_memdump(addr, len)) {
        error_report("rehost: refused a machine write into the memdump region at 0x%"
                     PRIx64, addr);
        return false;
    }
    return address_space_write(&address_space_memory, addr, MEMTXATTRS_UNSPECIFIED,
                               buf, len) == MEMTX_OK;
}
/* end: guest memory access */

/* =========================================================================
 * Layer 1 - dedicated models (stateful devices)
 * Mapped first so they win over the shadow and catch-all layers. Record each as a
 * ledger entry with its kind (M model / V value / S stub) and the evidence, and one row
 * of the STATIC.md "address windows" table (model dedicated).
 * ========================================================================= */

typedef struct DedicatedRange { uint64_t base, size; const char *name; } DedicatedRange;
static DedicatedRange dedicated[MAX_DEDICATED];
static unsigned n_dedicated;

static void dedicated_note(uint64_t base, uint64_t size, const char *name) {
    if (n_dedicated >= MAX_DEDICATED) { error_report("rehost: too many dedicated windows"); exit(1); }
    dedicated[n_dedicated++] = (DedicatedRange){ base, size, name };
}

static bool dedicated_overlaps(uint64_t base, uint64_t size) {
    for (unsigned i = 0; i < n_dedicated; i++) {
        if (base < dedicated[i].base + dedicated[i].size &&
            dedicated[i].base < base + size) return true;
    }
    return false;
}

static void rehost_add_dedicated(MemoryRegion *sysmem, MemoryRegion *mr, const char *name,
                                 uint64_t base, uint64_t size,
                                 const MemoryRegionOps *ops, void *opaque) {
    memory_region_init_io(mr, NULL, ops, opaque, name, size);
    memory_region_add_subregion(sysmem, base, mr);
    dedicated_note(base, size, name);
}

/* ---- Poll diagnostic (every layer reports into it) ----
 * A register read POLL_THRESHOLD times in a row is a polling loop; it is reported once
 * per address. UNMODELLED / ACCESSED / POLL host lines are derivation input. */
static uint64_t poll_last, poll_count;
static uint64_t poll_reported[POLL_REPORT_MAX];
static unsigned poll_n_reported;

static void poll_note(uint64_t addr, uint64_t val) {
    if (addr == poll_last) {
        if (++poll_count == POLL_THRESHOLD) {
            for (unsigned i = 0; i < poll_n_reported; i++) {
                if (poll_reported[i] == addr) return;
            }
            if (poll_n_reported < POLL_REPORT_MAX) poll_reported[poll_n_reported++] = addr;
            HOST_LOG("POLL 0x%" PRIx64 " = 0x%" PRIx64, addr, val);
        }
    } else {
        poll_last = addr;
        poll_count = 0;
    }
}

/* One line per 4 KiB page the first time it is touched. kind is ACCESSED for a shadow
 * window and UNMODELLED for the catch-all: the same format, so a window opened in bulk
 * still shows which pages the firmware really used. */
static void log_first_access(const char *kind, bool is_write, uint64_t addr,
                             uint64_t val, const char *window) {
    if (is_write) {
        HOST_LOG("%s write 0x%" PRIx64 " = 0x%" PRIx64 " window=%s", kind, addr, val, window);
    } else {
        HOST_LOG("%s read  0x%" PRIx64 " window=%s", kind, addr, window);
    }
}

/* ---- UART: the honesty-critical device. Do not restructure. ---- */

static int uart_can_receive(void *opaque) {
    RehostMixedState *s = opaque;
    return sizeof(s->rx) - s->rx_count;
}
static void uart_receive(void *opaque, const uint8_t *buf, int sz) {
    RehostMixedState *s = opaque;
    for (int i = 0; i < sz && s->rx_count < sizeof(s->rx); i++) {
        s->rx[s->rx_head] = buf[i];
        s->rx_head = (s->rx_head + 1) % sizeof(s->rx);
        s->rx_count++;
    }
}
/* There is deliberately no function that fills rx[] from inside the machine. Input
 * arrives only through uart_receive above, i.e. from outside QEMU (honesty rule 7). */

/* Reported on stderr, never on the console: scripts/uart_harness.py reads these lines to
 * learn whether the firmware ever looked at its input, and whether it sits parked polling
 * it. A line carries only counters - nothing here can reach the console file. Field names
 * are single letters on purpose (verify.py asks whether a console token appears in a
 * machine string literal; nothing shorter than five characters can collide).
 *   s = bytes handed to the firmware   e = reads that found the buffer empty
 *   p = status-register polls          q = bytes still queued */
static void rehost_rx_report(RehostMixedState *s) {
    info_report("REHOST-RX s=%" PRIu64 " e=%" PRIu64 " p=%" PRIu64 " q=%u",
                s->rx_served, s->rx_empty, s->rx_polls, s->rx_count);
}

static uint64_t uart_read(void *opaque, hwaddr off, unsigned sz) {
    RehostMixedState *s = opaque;
    if (off == UART_STAT_OFF) {
        uint64_t st = UART_STAT_TX_READY;
        if (s->rx_count > 0) st |= UART_STAT_RX_READY;
        s->rx_polls++;
        if (s->rx_polls == 1 || (s->rx_polls & ((1ULL << 20) - 1)) == 0) rehost_rx_report(s);
        return st;
    }
    if (off == UART_RX_OFF && s->rx_count > 0) {
        uint8_t b = s->rx[s->rx_tail];
        s->rx_tail = (s->rx_tail + 1) % sizeof(s->rx);
        s->rx_count--;
        s->rx_served++;
        /* Required: once can_receive returned 0, QEMU stops feeding this chardev until
         * told the backlog cleared. */
        qemu_chr_fe_accept_input(&s->uart_chr);
        if (s->rx_count == 0) rehost_rx_report(s);
        return b;
    }
    if (off == UART_RX_OFF) {
        s->rx_empty++;
        if (s->rx_empty == 1 || (s->rx_empty & ((1ULL << 16) - 1)) == 0) rehost_rx_report(s);
    }
    return 0;
}

static void uart_write(void *opaque, hwaddr off, uint64_t val, unsigned sz) {
    RehostMixedState *s = opaque;
    if (off == UART_TX_OFF) {
        /* THE ONLY console write in this file. verify.py counts the call sites; a
         * second one means the machine can print, and then nothing on the console
         * proves the firmware printed it. */
        uint8_t b = val & 0xff;
        qemu_chr_fe_write_all(&s->uart_chr, &b, 1);
    }
}

static const MemoryRegionOps uart_ops = {
    .read = uart_read, .write = uart_write,
    .endianness = DEVICE_LITTLE_ENDIAN,
    .valid = { .min_access_size = 1, .max_access_size = 4 },
};

/* {{DEDICATED_MODELS_BLOCK}}
 * One model per window the firmware polls with a state machine (SoC timer, bus bridge to
 * the power-management chip, the boot-medium controller, power-domain and bus-protect
 * handshakes, ...). Each: ops + state, mapped in rehost_init() (DEDICATED_MAP_BLOCK)
 * through rehost_add_dedicated(). Derive the state machine from the firmware's own polling code
 * (runbook step S3); a fixed reply that merely lets the loop exit is a V entry whose side
 * effect says what is no longer exercised. Timer models: use rehost_virtual_ticks().
 * Registers whose meaning changes at the warm reset consult g_post_handoff.
 * A reset or watchdog block, if the firmware touches one, is a candidate too: its
 * accesses show up as ACCESSED / UNMODELLED host lines first, and this skeleton has no
 * guest-reset model of its own. */

/* =========================================================================
 * Layer 2 - shadow windows (read/write memory with first-access logging)
 * ========================================================================= */

typedef struct ShadowSpec { const char *name; uint64_t base, size; } ShadowSpec;
static const ShadowSpec shadow_specs[] = {
    /* {{SHADOW_WINDOWS_BLOCK}}
     * One row per peripheral window from the device tree (or code literals), with the
     * window's name. Each row has a row in the STATIC.md "address windows" table (model
     * shadow; columns in the Conventions at the top) - the source column says where the
     * base and size came from. A window that overlaps a dedicated model is skipped at map
     * time. */
    { .name = NULL }
};

typedef struct ShadowWindow {
    MemoryRegion mr;
    uint8_t *buf, *seen;
    uint64_t base, size;
    const char *name;
} ShadowWindow;

/* Read overrides: the value a polling loop waits for, injected at read time. Each row
 * is derived from the loop it unblocks (loop address, bit, why) and shares its row with
 * the STATIC.md "address windows" table (model override; same bypass id as the tag). */
enum { OVR_SET_BITS, OVR_CLEAR_BITS, OVR_EXACT };
typedef struct ReadOverride {
    const char *id;       /* bypass id; NULL ends the table */
    uint64_t addr;
    int mode;             /* OVR_SET_BITS: or in value; OVR_CLEAR_BITS: clear value; OVR_EXACT: report value */
    uint64_t value;
    unsigned phase;       /* PH_PRE, PH_POST or PH_BOTH */
} ReadOverride;
static const ReadOverride read_overrides[] = {
#if 0   /* the shape of one row; never compiled */
    { "<id>", {{WINDOW_ADDR}}ULL, OVR_SET_BITS, {{READY_BITS}}ULL, PH_BOTH },   /* bypass:<id> */
#endif
    { .id = NULL }
};

/* Register hooks: per-address behaviour that is not a plain value, kept in a table so
 * the shadow callbacks stay generic (no device special case inside shadow_read/write). */
typedef struct RegHook {
    const char *id;       /* bypass id; NULL ends the table */
    uint64_t addr;
    unsigned phase;
    bool (*read)(uint64_t addr, unsigned sz, uint64_t *val);       /* true = handled */
    void (*write)(uint64_t addr, uint64_t val, unsigned sz);       /* the store still happens */
} RegHook;
static const RegHook reg_hooks[] = {
#if 0   /* the shape of one row; never compiled */
    { "<id>", {{WINDOW_ADDR}}ULL, PH_BOTH, my_read_hook, my_write_hook },   /* bypass:<id> */
#endif
    { .id = NULL }
};

static uint64_t shadow_read(void *o, hwaddr a, unsigned sz) {
    ShadowWindow *w = o;
    uint64_t addr = w->base + a, v = 0;
    unsigned pg = a >> MMIO_PAGE_SHIFT;
    if (!w->seen[pg]) { w->seen[pg] = 1; log_first_access("ACCESSED", false, addr, 0, w->name); }
    for (const RegHook *h = reg_hooks; h->id; h++) {
        if (h->addr == addr && h->read && phase_active(h->phase) && h->read(addr, sz, &v)) {
            poll_note(addr, v);
            return v;
        }
    }
    if (a + sz <= w->size) v = ldn_le_p(w->buf + a, sz);
    for (const ReadOverride *r = read_overrides; r->id; r++) {
        if (r->addr != addr || !phase_active(r->phase)) continue;
        if (r->mode == OVR_SET_BITS) v |= r->value;
        else if (r->mode == OVR_CLEAR_BITS) v &= ~r->value;
        else v = r->value;
    }
    poll_note(addr, v);
    return v;
}

static void shadow_write(void *o, hwaddr a, uint64_t v, unsigned sz) {
    ShadowWindow *w = o;
    uint64_t addr = w->base + a;
    unsigned pg = a >> MMIO_PAGE_SHIFT;
    if (!w->seen[pg]) { w->seen[pg] = 1; log_first_access("ACCESSED", true, addr, v, w->name); }
    for (const RegHook *h = reg_hooks; h->id; h++) {
        if (h->addr == addr && h->write && phase_active(h->phase)) h->write(addr, v, sz);
    }
    if (a + sz <= w->size) stn_le_p(w->buf + a, sz, v);
}

static const MemoryRegionOps shadow_ops = {
    .read = shadow_read, .write = shadow_write,
    .endianness = DEVICE_LITTLE_ENDIAN,
    .valid = { .min_access_size = 1, .max_access_size = 8 },
};

static void rehost_map_shadows(MemoryRegion *sysmem) {
    unsigned mapped = 0, skipped = 0;
    for (const ShadowSpec *sp = shadow_specs; sp->name; sp++) {
        if (dedicated_overlaps(sp->base, sp->size)) { skipped++; continue; }
        ShadowWindow *w = g_new0(ShadowWindow, 1);
        w->name = sp->name;
        w->base = sp->base;
        w->size = sp->size;
        w->buf = g_malloc0(sp->size);
        w->seen = g_malloc0((sp->size >> MMIO_PAGE_SHIFT) + 1);
        memory_region_init_io(&w->mr, NULL, &shadow_ops, w, sp->name, sp->size);
        memory_region_add_subregion(sysmem, sp->base, &w->mr);
        mapped++;
    }
    HOST_LOG("%u shadow windows mapped, %u skipped (dedicated model overlaps)", mapped, skipped);
}

/* =========================================================================
 * Layer 3 - catch-all (priority below every real window)
 * Reads 0, writes ignored. UNMODELLED lines are derivation input: a page listed there
 * is real hardware the firmware touched that nothing models yet.
 * ========================================================================= */

typedef struct CatchAll { MemoryRegion mr; uint8_t *seen; } CatchAll;

static uint64_t catchall_read(void *o, hwaddr a, unsigned sz) {
    CatchAll *c = o;
    unsigned pg = a >> MMIO_PAGE_SHIFT;
    if (!c->seen[pg]) { c->seen[pg] = 1; log_first_access("UNMODELLED", false, CATCHALL_BASE + a, 0, "catchall"); }
    poll_note(CATCHALL_BASE + a, 0);
    return 0;
}
static void catchall_write(void *o, hwaddr a, uint64_t v, unsigned sz) {
    CatchAll *c = o;
    unsigned pg = a >> MMIO_PAGE_SHIFT;
    if (!c->seen[pg]) { c->seen[pg] = 1; log_first_access("UNMODELLED", true, CATCHALL_BASE + a, v, "catchall"); }
}
static const MemoryRegionOps catchall_ops = {
    .read = catchall_read, .write = catchall_write,
    .endianness = DEVICE_LITTLE_ENDIAN,
    .valid = { .min_access_size = 1, .max_access_size = 8 },
};

/* =========================================================================
 * Stage placement and reserved regions
 * ========================================================================= */

/* Exactly the executable stages with origin "container" in stage_map.json, in chain
 * order. A stage the map marked encrypted or absent is NOT listed: it cannot run, and a
 * stage whose origin is "medium" or "handoff" is loaded by the firmware itself. */
typedef struct StagePlace {
    const char *name;
    bool aarch32;
    uint64_t file_off, size, load_va, entry_pc;
} StagePlace;
static const StagePlace stages[] = {
    /* {{STAGE_TABLE_BLOCK}}
     * { "<name>", true, <file_range start>, <size>, <load_base>, <entry_pc> }, ...
     * entry_pc is the field the machine and every PC watcher use - never load_base. */
    { .name = NULL }
};

/* Memory the firmware reserves for itself (derived from the bootloader's own reservation
 * log or the device tree). Logged at init so STATIC.md can cite them; the machine does not
 * model them. NOT the host-read memdump region: that one is never listed in this source
 * (see the note at the top, REHOST_MEMDUMP_REGION). */
typedef struct ReservedSpan { const char *name; uint64_t base, size; } ReservedSpan;
static const ReservedSpan reserved_spans[] = {
    /* {{RESERVED_SPANS_BLOCK}}
     * { "<name>", <base>, <size> }, ... */
    { .name = NULL }
};

/* Whichever RAM region backs a guest address. Container-time writes go through the
 * region pointer: no translated block exists yet. */
static uint8_t *host_for(RehostMixedState *s, MachineState *ms, uint64_t va, uint64_t len) {
    struct { MemoryRegion *mr; uint64_t base, size; } regions[] = {
        { ms->ram,   DRAM_BASE, DRAM_SIZE },
        { &s->sram,  SRAM_BASE, SRAM_SIZE },
    };
    for (size_t i = 0; i < ARRAY_SIZE(regions); i++) {
        if (va >= regions[i].base && va + len <= regions[i].base + regions[i].size) {
            return memory_region_get_ram_ptr(regions[i].mr) + (va - regions[i].base);
        }
    }
    return NULL;
}

/* =========================================================================
 * Runtime patch ledger engine
 *
 * Every patch row is one entry of 06_machine/bypasses.md ("one row, one entry"). The
 * engine only applies a row when:
 *   - its TARGET (the code being patched) is identified as the build the row was
 *     derived from: the hash of an identifier readable in guest memory (a version
 *     string, for example) equals the derived one;
 *   - every row of its GROUP matches its pre-image at the same moment (a bypass made of
 *     several rows is applied all-or-nothing);
 * otherwise the row is NOT applied and the reason is recorded: refused at load time, or
 * listed as not applied in the report at exit. Nothing is patched "best effort".
 * Rows apply at load time (before the first instruction) or at runtime (a virtual-time
 * poll, once the target code has been loaded by an earlier stage); the target records
 * which stage that is, for the ledger.
 * ========================================================================= */

/* begin: patch engine */
typedef enum { PATCH_AT_LOAD, PATCH_AT_RUNTIME } PatchWhen;
typedef enum { PS_PENDING, PS_APPLIED, PS_REFUSED } PatchState;

typedef struct PatchTarget {
    const char *name;      /* ledger name of the code being patched; NULL ends the table */
    uint64_t id_addr;      /* guest address where the build identifier is readable */
    uint32_t id_len;       /* <= PATCH_ID_MAX */
    uint32_t id_hash;      /* FNV-1a 32 of those bytes, from the target firmware (STATIC.md) */
    const char *when;      /* ledger text: before/after which stage's execution rows apply */
} PatchTarget;
static const PatchTarget patch_targets[] = {
    /* {{PATCH_TARGETS_BLOCK}}
     * { "<name>", <id_addr>, <id_len>, <id_hash>, "<when>" }, ... */
    { .name = NULL }
};

typedef struct PatchRow {
    const char *id;        /* "<id>" of the ledger entry "#<id>"; NULL ends the table */
    unsigned group;        /* rows of one bypass share a group; non-zero */
    int target;            /* index into patch_targets[] */
    PatchWhen when;        /* all rows of a group share it */
    uint64_t addr;         /* guest physical address (KERNEL_VA_TO_PA() for kernel rows) */
    unsigned len;          /* 1..PATCH_MAX_LEN */
    uint8_t from[PATCH_MAX_LEN];   /* pre-image */
    uint8_t to[PATCH_MAX_LEN];
} PatchRow;
static const PatchRow patch_rows[] = {
#if 0   /* the shape of one row; never compiled */
    { "<id>", 1, 0, PATCH_AT_RUNTIME, {{PATCH_ADDR}}ULL, 2, { {{FROM_BYTES}} }, { {{TO_BYTES}} } },   /* bypass:<id> */
#endif
    /* {{PATCH_ROWS_BLOCK}} - one row per changed location, each tagged bypass:<id>. */
    { .id = NULL }
};

static PatchState *patch_state;
static unsigned patch_n_rows;

static uint32_t fnv1a32(const uint8_t *p, size_t n) {
    uint32_t h = 2166136261u;
    while (n--) { h ^= *p++; h *= 16777619u; }
    return h;
}

static bool patch_target_confirmed(int t, uint32_t *seen) {
    const PatchTarget *pt = &patch_targets[t];
    uint8_t buf[PATCH_ID_MAX];
    if (!rehost_guest_read(pt->id_addr, buf, pt->id_len)) { *seen = 0; return false; }
    *seen = fnv1a32(buf, pt->id_len);
    return *seen == pt->id_hash;
}

static bool patch_row_matches(const PatchRow *r) {
    uint8_t cur[PATCH_MAX_LEN];
    return rehost_guest_read(r->addr, cur, r->len) && !memcmp(cur, r->from, r->len);
}

/* Can the whole group be applied now? On no, `why` says which row or target stops it. */
static bool patch_group_ready(unsigned group, PatchWhen when, char *why, size_t why_len) {
    for (unsigned i = 0; i < patch_n_rows; i++) {
        const PatchRow *r = &patch_rows[i];
        uint32_t seen;
        if (r->group != group || r->when != when) continue;
        if (!patch_target_confirmed(r->target, &seen)) {
            snprintf(why, why_len, "target '%s' build not confirmed (id hash 0x%x, derived 0x%x)",
                     patch_targets[r->target].name, seen, patch_targets[r->target].id_hash);
            return false;
        }
        if (!patch_row_matches(r)) {
            snprintf(why, why_len, "pre-image mismatch at 0x%" PRIx64 " (row %s)", r->addr, r->id);
            return false;
        }
    }
    return true;
}

static void patch_group_apply(unsigned group, PatchWhen when) {
    for (unsigned i = 0; i < patch_n_rows; i++) {
        const PatchRow *r = &patch_rows[i];
        if (r->group != group || r->when != when) continue;
        if (!rehost_guest_write(r->addr, r->to, r->len)) {
            error_report("rehost: patch write failed at 0x%" PRIx64 " (row %s)", r->addr, r->id);
            exit(1);   /* a half-applied group is worse than a stopped run */
        }
        patch_state[i] = PS_APPLIED;
        HOST_LOG("patch applied  %s group=%u @0x%" PRIx64 " target=%s when=\"%s\"", r->id, r->group,
                 r->addr, patch_targets[r->target].name, patch_targets[r->target].when);
    }
}

/* Try every pending group of `when`. At load time a group that cannot apply is refused
 * for good (the pre-image is final); at runtime it stays pending. */
static void patch_try(PatchWhen when) {
    char why[160];
    for (unsigned i = 0; i < patch_n_rows; i++) {
        const PatchRow *r = &patch_rows[i];
        if (r->when != when || patch_state[i] != PS_PENDING) continue;
        if (patch_group_ready(r->group, when, why, sizeof(why))) {
            patch_group_apply(r->group, when);
        } else if (when == PATCH_AT_LOAD) {
            for (unsigned j = 0; j < patch_n_rows; j++) {
                if (patch_rows[j].group == r->group && patch_rows[j].when == when) {
                    patch_state[j] = PS_REFUSED;
                }
            }
            HOST_LOG("PATCH-REFUSED %s group=%u: %s", r->id, r->group, why);
        }
    }
}

static void patch_tick(void *opaque) {
    RehostMixedState *s = opaque;
    patch_try(PATCH_AT_RUNTIME);
    timer_mod(s->patch_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + PATCH_POLL_MS);
}

/* The ledger of what actually happened, one host line per row, at exit. A row that is
 * not "applied" must appear in bypasses.md's side effects as not exercised. A run ended
 * with SIGKILL skips this report; the absence of a "patch applied" line for a row means
 * the same thing, because applying logs at the moment it happens. */
static void patch_ledger_report(Notifier *n, void *data) {
    char why[160];
    for (unsigned i = 0; i < patch_n_rows; i++) {
        const PatchRow *r = &patch_rows[i];
        if (patch_state[i] == PS_APPLIED) {
            HOST_LOG("patch ledger: %s group=%u applied", r->id, r->group);
        } else if (!g_patches_enabled) {
            HOST_LOG("patch ledger: %s group=%u NOT applied: disabled by REHOST_RUNTIME_PATCHES", r->id, r->group);
        } else {
            why[0] = '\0';
            patch_group_ready(r->group, r->when, why, sizeof(why));
            HOST_LOG("patch ledger: %s group=%u NOT applied: %s", r->id, r->group,
                     why[0] ? why : "never became ready");
        }
    }
}
static Notifier patch_exit_notifier = { .notify = patch_ledger_report };

static void patch_engine_init(void) {
    while (patch_rows[patch_n_rows].id) patch_n_rows++;
    patch_state = g_new0(PatchState, patch_n_rows + 1);
    unsigned n_targets = 0;
    while (patch_targets[n_targets].name) n_targets++;
    for (unsigned i = 0; i < patch_n_rows; i++) {
        const PatchRow *r = &patch_rows[i];
        if (!r->group || r->len < 1 || r->len > PATCH_MAX_LEN || r->target < 0 ||
            (unsigned)r->target >= n_targets || patch_targets[r->target].id_len > PATCH_ID_MAX) {
            error_report("rehost: malformed patch row %s", r->id); exit(1);
        }
        if (in_memdump(r->addr, r->len)) {   /* the host-read region is never patched */
            error_report("rehost: patch row %s targets the memdump region", r->id); exit(1);
        }
        for (unsigned j = 0; j < i; j++) {
            if (patch_rows[j].group == r->group && patch_rows[j].when != r->when) {
                error_report("rehost: group %u mixes load-time and runtime rows", r->group); exit(1);
            }
        }
    }
    HOST_LOG("patch ledger: %u rows, runtime patching %s", patch_n_rows,
             g_patches_enabled ? "on" : "OFF (REHOST_RUNTIME_PATCHES)");
    qemu_add_exit_notifier(&patch_exit_notifier);
}
/* end: patch engine */

/* =========================================================================
 * Container placement and load-time patches
 * ========================================================================= */

static void place_stages(RehostMixedState *s, MachineState *ms) {
    if (!ms->kernel_filename) {
        error_report("no container given (-kernel <container.bin>)"); exit(1);
    }
    FILE *f = fopen(ms->kernel_filename, "rb");
    if (!f) { error_report("cannot open '%s'", ms->kernel_filename); exit(1); }
    fseek(f, 0, SEEK_END); long total = ftell(f); fseek(f, 0, SEEK_SET);
    if (total <= 0) { error_report("empty container"); exit(1); }
    uint8_t *buf = g_malloc0(total);
    if (fread(buf, 1, total, f) != (size_t)total) { error_report("short read"); exit(1); }
    fclose(f);

    unsigned n = 0;
    for (const StagePlace *st = stages; st->name; st++, n++) {
        if (st->file_off + st->size > (uint64_t)total) {
            error_report("stage %s runs past the container", st->name); exit(1);
        }
        uint8_t *dst = host_for(s, ms, st->load_va, st->size);
        if (!dst) {
            error_report("stage %s: no RAM region covers 0x%" PRIx64, st->name, st->load_va);
            exit(1);
        }
        memcpy(dst, buf + st->file_off, st->size);
        HOST_LOG("stage %u placed at 0x%" PRIx64 " (%" PRIu64 " bytes, entry 0x%" PRIx64 ")",
                 n + 1, st->load_va, st->size, st->entry_pc);
    }
    g_free(buf);

    /* {{BOOT_ROM_OUTPUT_BLOCK}}
     * The first stage has no predecessor here, so whatever the boot ROM left it must be
     * supplied: registers (see cpu_reset_hook), memory words, function pointers it
     * calls. Derive each from the first stage's own use of it. Every one is a ledger
     * entry - this models the boot ROM's OUTPUT, the boot ROM itself is not executed.
     * Plain data slots are writes; slots the firmware CALLS need a tiny routine whose
     * result is what the call site tests, never what the slot's position suggests. */

    /* {{SKIP_REDIRECT_BLOCK}}
     * For each stage that cannot run (encrypted or absent): redirect the previous
     * stage's branch to it so it goes to the next EXECUTABLE stage's entry. A patch row
     * (pre-image checked, ledger entry), and never a value the skipped stage would have
     * written - if a later stage reads one, that is a finding. */

    patch_try(PATCH_AT_LOAD);
}

/* =========================================================================
 * CPUs, interrupt controller, handoff
 * ========================================================================= */

/* Features or registers the EL3 monitor touches that the CPU model lacks (it would take
 * an undefined-instruction exception there): one entry per access found at the faulting
 * ELR, as a feature bit set before realize or a register defined here (storage, or
 * read-as-zero/write-ignored when the value never reaches a branch). */
static void rehost_cpu64_features(ARMCPU *cpu) {
    /* {{CPU64_FEATURE_BLOCK}}
     * e.g. FIELD_DP64_IDREG(&cpu->isar, <ID register>, <field>, <value>) for a feature
     * class the monitor probes; each one a ledger entry (kind H or V). */
}
static void rehost_cpu64_cpregs(ARMCPU *cpu) {
    /* {{CPU64_CPREG_BLOCK}}
     * define_arm_cp_regs(cpu, <static ARMCPRegInfo table>) for implementation-defined
     * registers and identification registers the monitor reads (e.g. an MPIDR value the
     * next stage looks itself up by). Table rows tagged bypass:<id>. */
}

/* QEMU assigns CPU indexes in creation order, and the GIC maps index -> redistributor
 * frame. On the one reference device the monitor derived its core from MPIDR (core 0 ->
 * frame 0) and programmed that frame only; with the monitor CPU at index 1 the kernel's
 * redistributor was another frame, its private interrupts stayed secure, and no tick ever
 * arrived. Hence: the CPU that runs the monitor FIRST. This is a build-layer premise (a
 * fixer cannot repair it). Whether it applies to a chip is derived from the monitor's own
 * redistributor setup, not assumed.
 *
 * Stop point name: gic_redistributor_order (the family stop-point table under knowledge/). Its signature
 * is a kernel that stops ticking (log silent, CPUs idle in WFI, no exception storm) after
 * the bootloader and the monitor ran normally. The remedy is a REBUILD with the creation
 * order corrected - the order is decided right here, so this is where a rebuild changes it
 * (CPU_MONITOR / CPU_BOOT above). A fixer can only treat the next symptom. */
static void rehost_create_cpus(RehostMixedState *s) {
    Object *o64 = object_new(ARM_CPU_TYPE_NAME("{{CPU64_TYPE}}"));
    object_property_set_bool(o64, "has_el3", {{CPU64_HAS_EL3}}, &error_fatal);
    object_property_set_bool(o64, "has_el2", {{CPU64_HAS_EL2}}, &error_fatal);
    object_property_set_int(o64, "cntfrq", {{CNTFRQ_HZ}}, &error_fatal);
    object_property_set_int(o64, "mp-affinity", {{CPU64_MP_AFFINITY}}, &error_fatal);
    /* Parked until the warm reset: powered off, and never a PSCI-started core. */
    object_property_set_bool(o64, "start-powered-off", true, &error_fatal);
    rehost_cpu64_features(ARM_CPU(o64));
    qdev_realize(DEVICE(o64), NULL, &error_fatal);
    s->cpu[CPU_MONITOR] = ARM_CPU(o64);
    rehost_cpu64_cpregs(s->cpu[CPU_MONITOR]);

    Object *o32 = object_new(ARM_CPU_TYPE_NAME("{{CPU32_TYPE}}"));
    object_property_set_bool(o32, "aarch64", false, &error_fatal);   /* needs the cpu.c core patch */
    object_property_set_bool(o32, "has_el3", {{CPU32_HAS_EL3}}, &error_fatal);
    object_property_set_bool(o32, "has_el2", {{CPU32_HAS_EL2}}, &error_fatal);
    object_property_set_int(o32, "cntfrq", {{CNTFRQ_HZ}}, &error_fatal);
    object_property_set_int(o32, "mp-affinity", {{CPU32_MP_AFFINITY}}, &error_fatal);
    qdev_realize(DEVICE(o32), NULL, &error_fatal);
    s->cpu[CPU_BOOT] = ARM_CPU(o32);

    for (int i = 0; i < NUM_CPUS; i++) {
        g_assert(CPU(s->cpu[i])->cpu_index == i);   /* creation order = GIC CPU number */
    }
}

static void rehost_create_gic(RehostMixedState *s, MemoryRegion *sysmem) {
    DeviceState *gic = qdev_new("arm-gicv3");
    SysBusDevice *gsb = SYS_BUS_DEVICE(gic);
    qdev_prop_set_uint32(gic, "revision", GIC_REVISION);
    qdev_prop_set_uint32(gic, "num-cpu", NUM_CPUS);
    qdev_prop_set_uint32(gic, "num-irq", GIC_NUM_IRQ);
    QList *rc = qlist_new();
    qlist_append_int(rc, NUM_CPUS);
    qdev_prop_set_array(gic, "redist-region-count", rc);
    qdev_prop_set_bit(gic, "has-security-extensions", true);
    object_property_set_link(OBJECT(gic), "sysmem", OBJECT(sysmem), &error_fatal);
    sysbus_realize_and_unref(gsb, &error_fatal);
    sysbus_mmio_map(gsb, 0, GIC_DIST_BASE);
    sysbus_mmio_map(gsb, 1, GIC_REDIST_BASE);
    dedicated_note(GIC_DIST_BASE, GIC_DIST_SIZE, "gic-dist");
    dedicated_note(GIC_REDIST_BASE, (uint64_t)NUM_CPUS * GICV3_REDIST_SIZE, "gic-redist");

    for (int i = 0; i < NUM_CPUS; i++) {
        DeviceState *cpud = DEVICE(s->cpu[i]);
        /* Private interrupt ids of CPU i follow the shared ones: the same wiring
         * hw/arm/virt.c uses for the architected timers. */
        int intidbase = (GIC_NUM_IRQ - GIC_INTERNAL) + i * GIC_INTERNAL;
        const int timer_irq[] = {
            [GTIMER_PHYS] = ARCH_TIMER_NS_EL1_IRQ,
            [GTIMER_VIRT] = ARCH_TIMER_VIRT_IRQ,
            [GTIMER_HYP]  = ARCH_TIMER_NS_EL2_IRQ,
            [GTIMER_SEC]  = ARCH_TIMER_S_EL1_IRQ,
        };
        sysbus_connect_irq(gsb, i, qdev_get_gpio_in(cpud, ARM_CPU_IRQ));
        sysbus_connect_irq(gsb, NUM_CPUS + i, qdev_get_gpio_in(cpud, ARM_CPU_FIQ));
        sysbus_connect_irq(gsb, 2 * NUM_CPUS + i, qdev_get_gpio_in(cpud, ARM_CPU_VIRQ));
        sysbus_connect_irq(gsb, 3 * NUM_CPUS + i, qdev_get_gpio_in(cpud, ARM_CPU_VFIQ));
        for (unsigned t = 0; t < ARRAY_SIZE(timer_irq); t++) {
            qdev_connect_gpio_out(cpud, t, qdev_get_gpio_in(gic, intidbase + timer_irq[t]));
        }
    }
    s->gic = gic;
    /* Shared peripheral interrupts for dedicated models: qdev_get_gpio_in(s->gic, <spi>)
     * where <spi> is the device tree's interrupt number (the id minus the 32 private ones). */
}

/* ---- Handoff watcher (warm-reset request detection) ----
 * The AArch32 stage asks for a warm reset into AArch64 (writes the monitor's entry
 * address somewhere, sets a reset-request mode, parks in a wait-for-interrupt spin).
 * QEMU cannot switch one CPU between an AArch32-only and an AArch64 feature set, so a
 * second CPU sits powered off; when the boot CPU parks, the machine halts it for good,
 * resets the monitor CPU at the stored entry address and starts it. How the request
 * looks (spin PC range, where the entry is stored, which registers carry over) is
 * DERIVED per chip from the stage's disassembly - the defaults below are the
 * placeholders for exactly those three facts. */

static bool handoff_requested(RehostMixedState *s) {
    uint32_t pc = s->cpu[CPU_BOOT]->env.regs[15];
    return pc >= HANDOFF_SPIN_PC_LO && pc <= HANDOFF_SPIN_PC_HI;
}

static uint64_t handoff_entry_value(void) {
    /* {{HANDOFF_ENTRY_BLOCK}} - replace the body if the entry is communicated some
     * other way than two 32-bit words at fixed addresses. */
    uint32_t lo = 0, hi = 0;
    rehost_guest_read(HANDOFF_ENTRY_LO, &lo, sizeof(lo));
    rehost_guest_read(HANDOFF_ENTRY_HI, &hi, sizeof(hi));
    return ((uint64_t)hi << 32) | lo;
}

static void handoff_tick(void *opaque) {
    RehostMixedState *s = opaque;
    if (!handoff_requested(s)) {
        timer_mod(s->handoff_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + HANDOFF_POLL_MS);
        return;
    }
    ARMCPU *c32 = s->cpu[CPU_BOOT], *c64 = s->cpu[CPU_MONITOR];
    uint64_t entry = handoff_entry_value();
    HOST_LOG("warm reset to AArch64 requested (boot CPU pc=0x%x), entry=0x%" PRIx64,
             c32->env.regs[15], entry);
    CPU(c32)->halted = 1;
    g_post_handoff = true;
    /* {{HANDOFF_POST_BLOCK}}
     * State that changes meaning at this point (a timer scale, an identification
     * register the next stage reads, a controller's DMA semantics): set it HERE, after
     * the boot stage has finished reading the old value. Each is a ledger entry citing
     * g_post_handoff. */
    object_property_set_uint(OBJECT(c64), "rvbar", entry, &error_abort);
    cpu_reset(CPU(c64));
    /* A real core may keep its register file across the warm reset (AArch32 Rn is then
     * Xn of the AArch64 state). Copy exactly the registers the monitor's entry code reads
     * before writing them - HANDOFF_COPY_REGS comes from that disassembly, not from a
     * habit of copying everything. */
    g_assert(HANDOFF_COPY_REGS <= 15);
    for (int i = 0; i < HANDOFF_COPY_REGS; i++) {
        c64->env.xregs[i] = c32->env.regs[i];
    }
    /* Created powered off: QEMU treats a PSCI_OFF core as having no work, so its first
     * wait-for-interrupt would never wake. */
    c64->power_state = PSCI_ON;
    CPU(c64)->halted = 0;
    qemu_cpu_kick(CPU(c64));
}

static void heartbeat_tick(void *opaque) {
    RehostMixedState *s = opaque;
    HOST_LOG("heartbeat virt=%lld ms real=%lld ms",
             (long long)(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / SCALE_MS),
             (long long)(qemu_clock_get_ns(QEMU_CLOCK_REALTIME) / SCALE_MS));
    timer_mod(s->heartbeat_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 1000);
}

/* ---- CPU reset ---- */
static void cpu_reset_hook(void *opaque) {
    ARMCPU *cpu = opaque;
    CPUState *cs = CPU(cpu);
    cpu_reset(cs);
    if (!stages[0].name) { error_report("rehost: no stage table"); exit(1); }
    /* The first stage's own entry (stage_map.json entry_pc), NOT its load address: the
     * container's first bytes are a header, and entering there executes header bytes. */
    cpu_set_pc(cs, (vaddr)stages[0].entry_pc);
    /* {{RESET_STATE_BLOCK}} - only registers the first stage READS before it writes
     * them. Anything else here is invention. */
}

/* =========================================================================
 * Boot medium connection point
 * ========================================================================= */

/* The controller model (agent-written from the bootloader's own driver, using
 * templates/storage_hci.c.tmpl for UFS or the same method for eMMC; the method is to
 * model only what the real driver is observed to need) reaches the synthesised image
 * through s->medium. run_full.sh attaches it as -drive id=lu0, snapshot=on by default,
 * so the firmware's own writes never reach the image on disk. A model that maps the
 * file itself must keep writes private as well. */
static void rehost_medium_connect(RehostMixedState *s) {
    s->medium = blk_by_name("lu0");
    if (!s->medium) {
        warn_report("rehost: no -drive id=lu0; the boot medium controller has no backing");
    }
    /* {{MEDIUM_MODEL_BLOCK}}
     * Map the controller window and wire its interrupt here, through
     * rehost_add_dedicated(). Behaviour that differs before and after the warm reset
     * (DMA semantics, for instance) consults g_post_handoff. A model fitted to the
     * bootloader's driver and broken under the kernel's is a model of that driver's
     * expectations, not of the controller. */
}

/* =========================================================================
 * Machine init
 * ========================================================================= */

static void rehost_init(MachineState *ms) {
    RehostMixedState *s = REHOST_MIXED_MACHINE(ms);
    MemoryRegion *sysmem = get_system_memory();
    g_state = s;
    rehost_env_init();
    memdump_guard_init();

    if (ms->ram_size != DRAM_SIZE) {
        warn_report("rehost: -m differs from the derived DRAM size");
    }
    memory_region_add_subregion(sysmem, DRAM_BASE, ms->ram);
    memory_region_init_ram(&s->sram, NULL, "rehost.sram", SRAM_SIZE, &error_fatal);
    memory_region_add_subregion(sysmem, SRAM_BASE, &s->sram);

    /* Low vector page: every slot "b ." so an exception taken before the stage sets its
     * own vectors parks observably (assumed, not derived - see VECTOR_PAGE_BASE). */
    memory_region_init_ram(&s->vectors, NULL, "rehost.vectors", VECTOR_PAGE_SIZE, &error_fatal);
    memory_region_add_subregion(sysmem, VECTOR_PAGE_BASE, &s->vectors);
    {
        uint32_t *vec = memory_region_get_ram_ptr(&s->vectors);
        for (int i = 0; i < VECTOR_SLOTS; i++) stl_le_p(&vec[i], ARM_A32_B_SELF);
    }

    rehost_create_cpus(s);
    rehost_create_gic(s, sysmem);

    rehost_add_dedicated(sysmem, &s->uart_io, "rehost.uart", UART_BASE, UART_SIZE, &uart_ops, s);
    if (serial_hd(0)) {
        qemu_chr_fe_init(&s->uart_chr, serial_hd(0), &error_abort);
        qemu_chr_fe_set_handlers(&s->uart_chr, uart_can_receive,
                                 uart_receive, NULL, NULL, s, NULL, true);
    }
    /* {{DEDICATED_MAP_BLOCK}} - map each dedicated model here (rehost_add_dedicated). */

    /* The boot medium controller is a dedicated model too: it must be mapped before the
     * shadow layer so that layer skips the window it overlaps. */
    rehost_medium_connect(s);

    for (const ReservedSpan *r = reserved_spans; r->name; r++) {
        HOST_LOG("reserved %s 0x%" PRIx64 " size 0x%" PRIx64, r->name, r->base, r->size);
    }

    rehost_map_shadows(sysmem);

    CatchAll *ca = g_new0(CatchAll, 1);
    ca->seen = g_malloc0((CATCHALL_SIZE >> MMIO_PAGE_SHIFT) + 1);
    memory_region_init_io(&ca->mr, NULL, &catchall_ops, ca, "rehost.catchall", CATCHALL_SIZE);
    memory_region_add_subregion_overlap(sysmem, CATCHALL_BASE, &ca->mr, -10);

    patch_engine_init();
    place_stages(s, ms);

    s->handoff_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, handoff_tick, s);
    timer_mod(s->handoff_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + HANDOFF_POLL_MS);
    if (g_patches_enabled && patch_n_rows) {
        s->patch_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, patch_tick, s);
        timer_mod(s->patch_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + PATCH_POLL_MS);
    }
    if (getenv("REHOST_HEARTBEAT")) {
        s->heartbeat_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, heartbeat_tick, s);
        timer_mod(s->heartbeat_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 1000);
    }

    qemu_register_reset(cpu_reset_hook, s->cpu[CPU_BOOT]);
}

static const char * const rehost_valid_cpu_types[] = {
    ARM_CPU_TYPE_NAME("{{CPU64_TYPE}}"), ARM_CPU_TYPE_NAME("{{CPU32_TYPE}}"), NULL,
};

static void rehost_class_init(ObjectClass *oc, const void *data) {
    MachineClass *mc = MACHINE_CLASS(oc);
    mc->desc = "{{MODEL}} mixed-architecture chain (auto-generated by sboot-rehost)";
    mc->init = rehost_init;
    /* -smp counts CPUs QEMU instantiates for the board: none. The machine creates its
     * own NUM_CPUS CPUs (creation order matters), so it does not honour -smp. */
    mc->max_cpus = 1;
    mc->min_cpus = 1;
    mc->default_cpus = 1;
    mc->default_cpu_type = ARM_CPU_TYPE_NAME("{{CPU64_TYPE}}");
    mc->valid_cpu_types = rehost_valid_cpu_types;
    mc->default_ram_size = DRAM_SIZE;
    mc->default_ram_id = "rehost.dram";
    mc->no_floppy = true;
    mc->no_cdrom = true;
}

static const TypeInfo rehost_info = {
    .name = TYPE_REHOST_MIXED_MACHINE,
    .parent = TYPE_MACHINE,
    .instance_size = sizeof(RehostMixedState),
    .class_init = rehost_class_init,
    /* REQUIRED on QEMU 10.2.2: without it the type registers but `-M help` and
     * `-M <name>` never find it. This machine creates an AArch64 CPU, so it belongs in
     * qemu-system-aarch64 only (qemu-system-arm has no AArch64 CPU model). */
    .interfaces = aarch64_machine_interfaces,
};

static void rehost_register(void) { type_register_static(&rehost_info); }
type_init(rehost_register)
